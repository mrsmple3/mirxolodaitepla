---
import '../styles/tokens.css';
import '../styles/motion.css';
import Backdrop from '../components/Backdrop.astro';
import Mark from '../components/Mark.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { business, serviceGroups, telHref, phoneDisplay, openingHoursText } from '../data/business.ts';
import { absoluteUrl } from '../data/site.ts';

interface Props {
  /** ≤ 60 символов. */
  title: string;
  /** 140–160 символов. */
  description: string;
  /** Путь страницы со слэшем на конце: '/', '/kontakty/'. */
  path: string;
  /** Готовая строка JSON-LD из src/lib/schema.ts. Один слот на страницу. */
  jsonLd?: string | undefined;
  ogType?: 'website' | 'article';
  /** Не индексировать (404). */
  noindex?: boolean;
}

const { title, description, path, jsonLd, ogType = 'website', noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('/og.png');

/** Навигация строится из данных: ссылка появляется вместе со страницей. */
const serviceLinks = business.services
  .filter((s) => s.status === 'live')
  .map((s) => ({ href: `/${s.slug}/`, label: s.name }));

/*
 * В подвале — весь список плоско: там место есть, и это единственная
 * навигация, доступная с телефона.
 */
const pageLinks = [
  ...serviceLinks,
  { href: '/o-mastere/', label: 'О мастере' },
  { href: '/blog/', label: 'Блог' },
  { href: '/kontakty/', label: 'Контакты' },
];

/*
 * В шапке шесть услуг сворачиваются в одно меню, иначе навигация занимает
 * две строки и шапка вырастает вдвое. Порядок групп ставит сезон — тот же,
 * что на главной. Раскрытие на <details>, без единой строчки JS (CLAUDE.md).
 */
const menuGroups = serviceGroups();
const onService = serviceLinks.some((l) => l.href === path);

const topLinks = [
  { href: '/o-mastere/', label: 'О мастере' },
  { href: '/blog/', label: 'Блог' },
  { href: '/kontakty/', label: 'Контакты' },
];
---

<!doctype html>
<html lang="ru" data-season={business.season}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/*
      Знак и фавиконки собирает scripts/make-brand.mjs, цвет ставит сезон.

      Порядок и состав — под то, как иконку ищут разные потребители:
        .ico  — за ним ходят по умолчанию, не читая разметку;
        .svg  — его берут все современные браузеры;
        192   — растровая для поиска: Google просит квадрат со стороной,
                кратной 48 px, и 32 или 180 под это правило не подходят.
      Иконка 32×32 отдельной ссылкой больше не нужна: она лежит внутри .ico.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Только display-начертание: им набран h1, он же LCP. */}
    <link
      rel="preload"
      href="/fonts/golos-text-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>

    <Backdrop />

    {/*
      Шкала прочитанного. Стрелка прибора по верхней кромке: привязана к
      позиции прокрутки через scroll(), а не ко времени, поэтому не крутит
      кадры на месте. Без поддержки scroll-driven animations её просто нет.
    */}
    <div class="progress" aria-hidden="true"></div>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-header__name" href="/">
          <Mark />
          <span>{business.name}</span>
        </a>

        {/*
          Навигация в шапке — на десктопе. На мобильном её место занимает
          полоса вызова: на телефоне сайт решает одну задачу, а не показывает меню.
          Полный список ссылок есть в подвале каждой страницы.
        */}
        <nav class="site-nav" aria-label="Основная навигация">
          <details class:list={['menu', { 'menu--here': onService }]}>
            <summary class="menu__summary">Услуги</summary>

            <div class="menu__panel">
              {
                menuGroups.map((group) => (
                  <div class="menu__group">
                    <p class="inst menu__label">{group.label}</p>
                    <ul>
                      {group.services.map((s) => (
                        <li>
                          <a
                            href={`/${s.slug}/`}
                            aria-current={path === `/${s.slug}/` ? 'page' : undefined}
                          >
                            <ServiceIcon domain={s.domain} />
                            <span>{s.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </details>

          <ul class="site-nav__list">
            {
              topLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {/*
          Телефон оформлен портом коллектора, а не строкой текста: латунная
          кромка сверху, хайрлайн по контуру, цифры моноширинной. Это тот же
          объект, что плитки контактов, — шапка перестаёт быть набором надписей.
        */}
        <a class="site-header__phone" href={telHref}>
          <span class="inst inst--muted site-header__label">Круглосуточно</span>
          <span class="site-header__number">{phoneDisplay}</span>
        </a>
      </div>
      <div class="scale" role="presentation"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/*
      Телефон в зоне большого пальца, виден всегда и на любой странице
      (SPEC §8, CLAUDE.md). Только мобильный: на десктопе телефон в шапке.
      position: fixed — в поток не входит, CLS не даёт.
    */}
    <div class="call-bar">
      <a class="btn call-bar__btn" href={telHref}>Позвонить</a>
      <a class="btn btn--ghost call-bar__btn" href={business.telegram.url} rel="noopener">
        {business.telegram.label}
      </a>
    </div>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <address class="site-footer__nap">
          <p class="site-footer__name">
            <Mark size="s" />
            <span>{business.name}</span>
          </p>
          <p>
            Мастер {business.master.firstName}, {business.address.addressLocality}.
            {business.areaServedText}.
          </p>
          <p>
            <a class="site-footer__link" href={telHref}>{phoneDisplay}</a>
            <span aria-hidden="true"> · </span>
            <a class="site-footer__link" href={business.telegram.url} rel="noopener">
              {business.telegram.label}
            </a>
          </p>
          <p class="inst site-footer__hours">00:00–23:59 · {openingHoursText}</p>
        </address>

        <nav class="site-footer__nav" aria-label="Все страницы">
          <ul>
            {
              pageLinks.map((link) => (
                <li>
                  <a class="site-footer__link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>

    <style>
      /* ── Шапка ──────────────────────────────────────────────── */
      /*
       * Одна строка, а не две. Раньше шесть услуг и три страницы шли плоским
       * списком, он переносился на второй ряд, и шапка занимала под 140 px —
       * рыхлая полоса текста над каждой страницей. Услуги свёрнуты в меню,
       * знак и порт телефона дают строке два опорных объекта.
       */
      .site-header {
        position: relative;
        z-index: 10;
        background: var(--c-surface);
      }

      /*
       * Липкой шапка становится только на десктопе. На телефоне её место
       * в зоне большого пальца уже занято полосой вызова, и вторая
       * закреплённая полоса съела бы экран с обеих сторон.
       */
      @media (width >= 60rem) {
        .site-header {
          position: sticky;
          inset-block-start: 0;
          box-shadow: 0 1px 0 var(--c-hairline);
        }
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-m);
        padding-block: var(--sp-2xs);
      }

      .site-header__name {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2xs);
        min-block-size: var(--tap-min);
        color: var(--c-graphite);
        font-size: var(--fs-300);
        font-weight: 700;
        letter-spacing: -0.01em;
        text-decoration: none;
      }

      .site-header__name:hover {
        color: var(--c-graphite);
      }

      /* ── Навигация ──────────────────────────────────────────── */
      .site-nav {
        display: none;
        align-items: center;
        gap: var(--sp-m);
        margin-inline-start: auto;
      }

      .site-nav__list {
        display: flex;
        align-items: center;
        gap: var(--sp-m);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .site-nav__list li + li {
        margin-block-start: 0;
      }

      /*
       * Подчёркивание — отдельная кромка, а не text-decoration: она умеет
       * выезжать слева направо и не дёргает базовую линию при наведении.
       */
      .site-nav a,
      .menu__summary {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-min);
        font-size: var(--fs-100);
        color: var(--c-muted);
        text-decoration: none;
      }

      .site-nav__list a::after,
      .menu__summary::before {
        content: '';
        position: absolute;
        inset-block-end: 0.55rem;
        inset-inline: 0;
        block-size: 2px;
        background: currentColor;
        scale: 0 1;
        transform-origin: 0 50%;
        transition: scale var(--dur-base) var(--ease-out);
      }

      .menu__summary::before {
        inset-inline-end: 1rem;
      }

      .site-nav a:hover,
      .menu__summary:hover {
        color: var(--c-accent-hover);
      }

      .site-nav__list a:hover::after,
      .menu__summary:hover::before {
        scale: 1 1;
      }

      .site-nav__list a[aria-current='page'] {
        color: var(--c-graphite);
        font-weight: 700;
      }

      .site-nav__list a[aria-current='page']::after {
        background: var(--c-brass);
        scale: 1 1;
      }

      /* ── Меню услуг: <details>, ноль JS ─────────────────────── */
      .menu {
        position: relative;
      }

      .menu__summary {
        gap: var(--sp-3xs);
        padding-inline-end: 1rem;
        cursor: pointer;
        list-style: none;
      }

      .menu__summary::-webkit-details-marker {
        display: none;
      }

      /* Шеврон рисуется руками: display: flex снимает нативный маркер. */
      .menu__summary::after {
        content: '';
        position: absolute;
        inset-inline-end: 0.1rem;
        inline-size: 0.4em;
        block-size: 0.4em;
        border-inline-end: 2px solid var(--c-brass);
        border-block-end: 2px solid var(--c-brass);
        rotate: 45deg;
        translate: 0 -0.15em;
        transition: rotate var(--dur-fast) var(--ease-out);
      }

      .menu[open] .menu__summary::after {
        rotate: -135deg;
        translate: 0 0.1em;
      }

      /* Открытая страница услуги подсвечивает само меню. */
      .menu--here .menu__summary {
        color: var(--c-graphite);
        font-weight: 700;
      }

      .menu--here .menu__summary::before {
        background: var(--c-brass);
        scale: 1 1;
      }

      .menu__panel {
        position: absolute;
        inset-block-start: calc(100% + var(--sp-2xs));
        inset-inline-start: 50%;
        translate: -50% 0;
        z-index: 5;
        display: flex;
        gap: var(--sp-l);
        padding: var(--sp-s) var(--sp-m) var(--sp-m);
        background: var(--c-surface);
        border: 1px solid var(--c-rule);
        border-block-start: 3px solid var(--c-brass);
        border-radius: var(--radius);
        box-shadow: var(--shadow-2);
      }

      .menu__group {
        min-inline-size: 0;
      }

      .menu__label {
        margin-block: 0 var(--sp-2xs);
        padding-block-end: var(--sp-2xs);
        border-block-end: 1px solid var(--c-rule);
      }

      .menu__panel ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .menu__panel li + li {
        margin-block-start: 0;
      }

      .menu__panel a {
        gap: var(--sp-2xs);
        min-block-size: 2.25rem;
        white-space: nowrap;
        color: var(--c-graphite);
      }

      .menu__panel a:hover {
        color: var(--c-accent-hover);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      .menu__panel a[aria-current='page'] {
        font-weight: 700;
      }

      /* ── Порт телефона ──────────────────────────────────────── */
      .site-header__phone {
        display: none;
        flex-direction: column;
        align-items: flex-end;
        justify-content: center;
        gap: 0;
        padding: var(--sp-3xs) var(--sp-xs);
        border: 1px solid var(--c-rule);
        border-block-start: 2px solid var(--c-brass);
        border-radius: var(--radius);
        text-decoration: none;
        color: var(--c-graphite);
        transition:
          border-color var(--dur-fast) var(--ease-out),
          box-shadow var(--dur-base) var(--ease-out);
      }

      .site-header__phone:hover {
        border-color: var(--c-accent);
        border-block-start-color: var(--c-accent);
        box-shadow: var(--shadow-1);
      }

      .site-header__label {
        line-height: 1.3;
      }

      .site-header__number {
        font-family: var(--font-inst);
        font-size: var(--fs-200);
        font-weight: 500;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        line-height: 1.25;
      }

      .site-header__phone:hover .site-header__number {
        color: var(--c-accent-hover);
      }

      @media (width >= 60rem) {
        .site-nav,
        .site-header__phone {
          display: flex;
        }
      }

      /* ── Подвал: корпус прибора ─────────────────────────────── */
      .site-footer {
        margin-block-start: var(--sp-xl);
        border-block-start: 3px solid var(--c-brass);
        background: var(--c-graphite);
        color: var(--c-dial);
      }

      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-m) var(--sp-l);
        justify-content: space-between;
        padding-block: var(--sp-l);
      }

      .site-footer__nap p {
        margin-block: 0 var(--sp-3xs);
        font-size: var(--fs-100);
      }

      .site-footer__name {
        display: flex;
        align-items: center;
        gap: var(--sp-2xs);
        font-size: var(--fs-200);
        font-weight: 700;
        color: var(--c-dial);
      }

      /* Цель нажатия не меньше 24 px (WCAG 2.5.8). */
      .site-footer__link {
        display: inline-flex;
        align-items: center;
        min-block-size: 1.75rem;
        color: var(--c-dial);
        text-underline-offset: 0.2em;
      }

      .site-footer__link:hover {
        color: var(--c-dial);
        text-decoration-thickness: 2px;
      }

      /* Латунь не набирает текст (SPEC §11.4): она только в кромке сверху. */
      .site-footer__hours {
        color: var(--c-dial);
        margin-block: var(--sp-2xs) 0;
        padding-block-start: var(--sp-2xs);
        border-block-start: 1px solid var(--c-brass);
      }

      /*
       * min-inline-size: 0 обязателен: без него флекс-элемент имеет min-width: auto,
       * auto-fit считается по max-content и раздвигает документ шире вьюпорта.
       * minmax(min(100%, …)) страхует тот же случай со стороны грида.
       */
      .site-footer__nav {
        min-inline-size: 0;
      }

      .site-footer__nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0 var(--sp-m);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
        font-size: var(--fs-100);
      }

      .site-footer__nav li + li {
        margin-block-start: 0;
      }

      .site-footer :focus-visible {
        outline-color: var(--c-brass);
      }

      /* ── Полоса вызова ──────────────────────────────────────── */
      .call-bar {
        position: fixed;
        inset-inline: 0;
        inset-block-end: 0;
        z-index: 20;
        display: flex;
        gap: var(--sp-2xs);
        padding: var(--sp-2xs) var(--sp-s);
        padding-block-end: calc(var(--sp-2xs) + env(safe-area-inset-bottom, 0px));
        background: var(--c-surface);
        border-block-start: 3px solid var(--c-brass);
      }

      .call-bar__btn {
        flex: 1;
        min-inline-size: 0;
        min-block-size: var(--tap-min);
        padding-inline: var(--sp-2xs);
        font-size: var(--fs-200);
      }

      @media (width >= 60rem) {
        .call-bar {
          display: none;
        }
      }
    </style>
  </body>
</html>
