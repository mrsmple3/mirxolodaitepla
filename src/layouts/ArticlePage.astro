---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CallToAction from '../components/CallToAction.astro';
import SideCall from '../components/SideCall.astro';
import { business } from '../data/business.ts';
import type { Article } from '../data/articles.ts';
import { blogPosting, breadcrumbs, graph, hvacBusiness } from '../lib/schema.ts';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const path = `/blog/${article.slug}/`;
const trail = [
  { name: 'Главная', path: '/' },
  { name: 'Блог', path: '/blog/' },
  { name: article.h1, path },
];

const service = business.services.find((s) => s.slug === article.relatedService);

const published = new Date(article.datePublished).toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = graph([
  hvacBusiness(),
  blogPosting({
    headline: article.h1,
    description: article.description,
    path,
    datePublished: article.datePublished,
  }),
  breadcrumbs(trail),
]);
---

<Base
  title={article.metaTitle}
  description={article.description}
  path={path}
  jsonLd={jsonLd}
  ogType="article"
>
  <div class="wrap shell">
   <article class="page post">
    <header class="post__head">
      <Breadcrumbs trail={trail} />

      <p class="eyebrow inst">Разбор мастера</p>

      <h1>{article.h1}</h1>

      <p class="post__lede">{article.lede}</p>

      <p class="post__meta">
        <span class="inst inst--muted">
          <time datetime={article.datePublished}>{published}</time>
        </span>
        <span class="post__author">
          {business.master.firstName}, мастер по кондиционерам и котлам
        </span>
      </p>
    </header>

    <div class="scale" role="presentation"></div>

    <div class="post__body">
      <slot />
    </div>

    <section class="post__next panel reveal">
      <p class="eyebrow inst">Что дальше</p>
      <h2>Что делать дальше</h2>
      <slot name="next" />
      {
        service && (
          <p>
            Подробнее про саму работу — на странице{' '}
            <a href={`/${service.slug}/`}>«{service.name}»</a>.
          </p>
        )
      }
      <CallToAction label="Ответ за 10 минут" />
    </section>
   </article>

   <SideCall />
  </div>
</Base>

<style>
  /* Та же двухколонная раскладка, что на страницах услуг. */
  .shell {
    display: grid;
    align-items: start;
    min-inline-size: 0;
  }

  /*
   * Обязательно: у элемента грида min-width: auto, и широкая таблица внутри
   * статьи раздвигала дорожку по своему min-content — вместо того чтобы
   * прокручиваться внутри .scroll. Документ становился шире вьюпорта на
   * 171 px при 360 px. Тот же дефект, из-за которого когда-то появился
   * `npm run viewport`; он же его и поймал.
   */
  .shell > * {
    min-inline-size: 0;
  }

  @media (width >= 75rem) {
    .shell {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--sp-l);
    }
  }

  .post__head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2xs);
  }

  .post__head h1 {
    margin-block: var(--sp-3xs) 0;
    max-inline-size: 24ch;
  }

  /*
   * Лид статьи — та же фраза, что стоит в списке блога. Берётся из данных,
   * а не пишется второй раз: список и страница обязаны обещать одно и то же.
   */
  .post__lede {
    font-size: var(--fs-300);
    color: var(--c-muted);
    margin: 0;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3xs) var(--sp-2xs);
    margin: 0;
    font-size: var(--fs-100);
    color: var(--c-muted);
  }

  .post__author::before {
    content: '· ';
    color: var(--c-brass);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);
  }

  /*
   * Латунная риска над заголовком раздела рисуется псевдоэлементом, а не
   * рамкой: рамку нельзя прочертить по мере прокрутки, а отрезок — можно
   * (motion.css). Без scroll-driven animations он просто стоит на месте.
   */
  .post__body :global(h2) {
    position: relative;
    font-size: var(--fs-400);
    margin-block: var(--sp-m) 0;
    padding-block-start: var(--sp-s);
    max-inline-size: var(--measure);
  }

  .post__body :global(h2)::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 2px;
    background: var(--c-brass);
    transform-origin: 0 50%;
  }

  .post__body :global(h3) {
    font-size: var(--fs-300);
    margin-block: var(--sp-2xs) 0;
  }

  .post__body :global(p),
  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0;
  }

  .post__body :global(table) {
    border-collapse: collapse;
    inline-size: 100%;
    max-inline-size: var(--measure);
    font-size: var(--fs-100);
  }

  .post__body :global(th),
  .post__body :global(td) {
    text-align: start;
    padding: var(--sp-2xs) var(--sp-xs);
    border-block-end: 1px solid var(--c-rule);
  }

  .post__body :global(th) {
    font-size: var(--fs-100);
    color: var(--c-muted);
    border-block-end: 2px solid var(--c-brass);
  }

  .post__body :global(td:first-child) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    font-weight: 700;
  }

  .post__body :global(.scroll) {
    overflow-x: auto;
  }

  .post__next {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2xs);
    margin-block-start: var(--sp-m);
  }

  .post__next h2 {
    font-size: var(--fs-400);
    margin-block-end: var(--sp-2xs);
    max-inline-size: var(--measure);
  }

  .post__next :global(p) {
    color: var(--c-muted);
  }
</style>
