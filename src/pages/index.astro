---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import Dial from '../components/Dial.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { business, serviceGroups } from '../data/business.ts';
import { articles } from '../data/articles.ts';
import { graph, hvacBusiness } from '../lib/schema.ts';

const title = 'Кондиционеры и котлы в Ташкенте — монтаж и ремонт';
const description =
  'Ровшан ставит, чистит и ремонтирует кондиционеры и котлы в Ташкенте. Работаю сам, круглосуточно. Пришлите фото в Telegram — назову цену за 10 минут.';

/*
 * Две группы: кондиционеры и котлы. Сезон из business.ts решает, какая идёт
 * первой. Меняется порядок и акцент, а не состав.
 */
const groups = serviceGroups();

/** Описания карточек — контент страницы, не данные о мастере. */
const summaries: Record<string, string> = {
  'ustanovka-konditsionera':
    'Кронштейны, трасса, вальцовка, опрессовка азотом, вакуумирование, пуск и замер на выходе.',
  'chistka-konditsionera':
    'Испаритель, крыльчатка, фильтры, дренажная ванна и трасса. Ташкентская пыль забивает всё за один сезон.',
  'zapravka-konditsionera-freonom':
    'Сначала поиск утечки и опрессовка, потом фреон. R32 и R410A не смешиваются между собой.',
  'remont-konditsionerov':
    'Не морозит, течёт, шумит, сам выключается, показывает ошибку на дисплее.',
  'obsluzhivanie-kotlov':
    'Падает давление, тухнет, не греет воду, шумит. Накипь в теплообменнике и расширительный бак.',
  'ustanovka-kotla':
    'Монтаж, обвязка контура, дымоход, группа безопасности, опрессовка и пуск. Работаю с газовым оборудованием.',
};

/*
 * Три показания первого экрана. Ни одно не придумано: всё это сказано
 * словами ниже по странице и на /o-mastere/. Здесь они вынесены наверх,
 * потому что до текста доходит не каждый, а до трёх строк — почти все.
 */
const facts = [
  { value: 'Сам', label: 'Без бригады и посредников' },
  { value: '24/7', label: 'Ночной вызов — обычный вызов' },
  { value: '10 мин', label: 'Ответ ценой по фото в Telegram' },
];

const objections = [
  {
    q: '«В магазине монтаж бесплатный»',
    a: 'Бесплатный монтаж — это базовый комплект: пара кронштейнов, короткая трасса и стандартное подключение. Обычно в него заложено около трёх метров трассы. Всё, что дальше, считают отдельно, и узнаёте вы об этом на месте — когда коробка уже вскрыта, а бригада стоит в коридоре. Отдельно идут штробление, короб, работа с автовышки или с промальпом, зимний комплект, откачка и дозаправка фреона. Я называю всё это до выезда, по фотографии.',
  },
  {
    q: '«Непонятно, сколько выйдет в итоге»',
    a: 'Цена собирается из вещей, которые видно на снимке: этаж и есть ли доступ к наружной стене, длина трассы от внутреннего блока до наружного, из чего стена, нужно ли штробить, нужен ли короб, не висит ли место под блоком над окном соседа или над проездом. Поэтому прайса на сайте нет: цифра «от» не говорит ничего, а две фотографии говорят всё. Пришлите их в Telegram — отвечу за десять минут.',
  },
  {
    q: '«Страшно за стену и за соседей снизу»',
    a: 'Сначала разметка и поиск проводки: сверлить вслепую нельзя. Отверстие идёт с уклоном наружу, чтобы конденсат уходил на улицу. Трасса режется по месту, концы развальцовываются под нужный конус — перетянутая вальцовка трескается не сразу, а через два-три месяца, и искать такую утечку дороже, чем сделать сразу. Дальше система стоит под азотом, пока не станет видно, что она держит давление. Потом вакуумирование: оно убирает из трассы воздух и влагу, потому что влага вместе с фреоном и маслом даёт кислоту, а кислота съедает обмотку компрессора. Дренаж кладётся с уклоном не меньше трёх миллиметров на метр — иначе вода рано или поздно найдёт дорогу к соседям.',
  },
];

const steps = [
  {
    title: 'Звонок или фото в Telegram',
    text: 'Фотографии стены под внутренний блок и места под наружный хватает, чтобы назвать цену за десять минут. Выезд на замер для этого не нужен.',
  },
  {
    title: 'Приезд и разметка',
    text: 'Ищу проводку в стене до того, как включить перфоратор. Показываю, где именно встанут блоки и как пойдёт трасса, — и только потом сверлю.',
  },
  {
    title: 'Блоки на месте',
    text: 'Кронштейны по уровню, отверстие с уклоном наружу — чтобы конденсат уходил на улицу, а не по обоям.',
  },
  {
    title: 'Трасса',
    text: 'Резка по месту, вальцовка под нужный конус, соединения, короб, уклон дренажа не меньше трёх миллиметров на метр.',
  },
  {
    title: 'Опрессовка, вакуум, пуск',
    text: 'Система стоит под азотом, пока не станет видно, что она держит. Потом вакуумирование, запуск и замер температуры на выходе. Мусор увожу с собой.',
  },
];

const jsonLd = graph([hvacBusiness()]);
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  {/* ── Первый экран ─────────────────────────────────────────── */}
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__intro">
        <p class="inst hero__place">
          {business.address.addressLocality} · выезд по городу
        </p>

        <h1 class="hero__title">
          Установка и обслуживание кондиционеров и котлов в {business.address.addressLocality}е
        </h1>

        <p class="hero__lead">
          Меня зовут {business.master.firstName}. Работаю сам, без бригады и посредников:
          кто взял трубку — тот и приедет. Выезжаю по {business.address.addressLocality}у.
        </p>

        <div class="offer hero__offer">
          <p class="inst hero__offer-label">Цена за 10 минут</p>
          <p class="hero__offer-text">
            Пришлите в {business.telegram.label} фото стены под внутренний блок и места
            под наружный. Отвечу ценой за десять минут — без выезда на замер.
          </p>
        </div>

        {/*
          На мобиле кнопки первого экрана не дублируются: те же два действия
          постоянно висят в нижней полосе вызова, в зоне большого пальца.
        */}
        <div class="hero__cta">
          <CallToAction showHours={false} />
        </div>
      </div>

      {/*
        Прибор первого экрана. Ниже 48rem снят намеренно: там его место
        занимает сам текст, а полоса вызова и так держит оба действия.
      */}
      <div class="hero__figure">
        <Dial />
      </div>
    </div>

    {/* Три показания вместо трёх абзацев про надёжность. */}
    <div class="wrap">
      <ul class="facts reveal-set">
        {
          facts.map((f) => (
            <li class="fact">
              <span class="fact__value">{f.value}</span>
              <span class="fact__label">{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="scale" role="presentation"></div>

  {/* ── Услуги ───────────────────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <SectionHead
          eyebrow="01 · Услуги"
          title="Что я делаю"
          lede="Кондиционеры и котлы — обе половины года. Порядок на странице переставляет сезон."
        />
      </div>

      {
        groups.map((group) => (
          <div class="services">
            <p class="inst services__label">{group.label}</p>
            <div class="grid-cards reveal-set">
              {group.services.map((service) => (
                <ServiceCard service={service} summary={summaries[service.slug] ?? ''} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="scale" role="presentation"></div>

  {/* ── Возражения ───────────────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <SectionHead
          eyebrow="02 · Возражения"
          title="Три вопроса, которые задают чаще всего"
        />
      </div>

      <div class="objections">
        {
          objections.map((o, i) => (
            <article class="qa reveal">
              <div class="qa__side">
                <span class="inst qa__no">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="qa__q">{o.q}</h3>
              </div>
              <p class="qa__a">{o.a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="scale" role="presentation"></div>

  {/* ── Как проходит работа ──────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <SectionHead
          eyebrow="03 · Порядок работы"
          title="Как проходит работа"
          lede="От звонка до замера температуры на выходе — пять шагов, каждый со своей проверкой."
        />
      </div>

      <ol class="steps">
        {
          steps.map((step, i) => (
            <li>
              <span class="inst step__no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="scale" role="presentation"></div>

  {/* ── Разборы ──────────────────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="reveal">
        <SectionHead
          eyebrow="04 · Разборы"
          title="Что можно понять до вызова мастера"
          lede="Пять статей про то, что чаще всего спрашивают по телефону. Половина случаев решается своими руками за пять минут — про это тоже написано."
        />
      </div>

      <ul class="posts reveal-set">
        {
          articles.map((a, i) => (
            <li class="post card lift">
              <span class="inst post__no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="post__title">
                <a href={`/blog/${a.slug}/`}>{a.h1}</a>
              </h3>
              <p class="post__lede">{a.lede}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Финальный блок связи ─────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="final panel reveal">
        <p class="inst eyebrow">05 · Связь</p>
        <h2 class="final__title">Позвоните или пришлите фото</h2>
        <p class="final__text">
          Если кондиционер не морозит или в котле упало давление — звоните сразу, разберём
          по телефону, что можно проверить до выезда. Котёл потух ночью — звоните ночью,
          график круглосуточный. Если нужен монтаж — отправьте фото, и я назову цену.
        </p>
        <CallToAction label="Ответ за 10 минут" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Первый экран ───────────────────────────────────────────── */
  .hero {
    padding-block: var(--sp-l) var(--sp-m);
  }

  .hero__grid {
    display: grid;
    gap: var(--sp-m);
    align-items: center;
  }

  /*
   * Прибор появляется с 48rem. Ниже он не «уменьшается», а снимается:
   * на телефоне первый экран должен доводить до кнопки, а не до картинки.
   */
  .hero__figure {
    display: none;
  }

  @media (width >= 48rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--sp-l);
    }

    .hero__figure {
      display: grid;
      justify-items: center;
      min-inline-size: 0;
    }
  }

  .hero__intro {
    min-inline-size: 0;
  }

  .hero__place {
    margin-block: 0 var(--sp-2xs);
  }

  /*
   * Заголовок работает картинкой: фотографий у сайта нет, и первый экран
   * держится на кегле и на прибое рядом. Он же LCP — поэтому никаких
   * анимаций прозрачности на самом тексте, только сдвиг всего блока.
   */
  .hero__title {
    font-size: var(--fs-700);
    letter-spacing: -0.025em;
    margin-block-end: var(--sp-s);
    max-inline-size: 18ch;
  }

  .hero__lead {
    font-size: var(--fs-300);
    color: var(--c-muted);
    margin-block-end: var(--sp-m);
  }

  .hero__offer {
    margin-block-end: var(--sp-m);
    max-inline-size: var(--measure);
  }

  .hero__offer-label {
    margin-block: 0 var(--sp-3xs);
  }

  .hero__offer-text {
    margin: 0;
    font-size: var(--fs-300);
  }

  .hero__cta {
    display: none;
  }

  @media (width >= 60rem) {
    .hero__cta {
      display: block;
    }
  }

  /* ── Показания ──────────────────────────────────────────────── */
  .facts {
    list-style: none;
    padding: 0;
    margin-block: var(--sp-m) 0;
    max-inline-size: none;
    display: grid;
    gap: var(--sp-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .facts li + li {
    margin-block-start: 0;
  }

  /* Кромка сверху вместо заливки — правило §11.4.5. */
  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3xs);
    min-inline-size: 0;
    padding-block-start: var(--sp-2xs);
    border-block-start: 2px solid var(--c-brass);
  }

  .fact__value {
    font-family: var(--font-inst);
    font-size: var(--fs-400);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .fact__label {
    font-size: var(--fs-100);
    color: var(--c-muted);
  }

  /* ── Услуги ─────────────────────────────────────────────────── */
  .services {
    margin-block-start: var(--sp-m);
  }

  .services__label {
    margin-block: 0 var(--sp-2xs);
    padding-block-end: var(--sp-2xs);
    border-block-end: 1px solid var(--c-rule);
  }

  /* ── Возражения ─────────────────────────────────────────────── */
  .objections {
    display: flex;
    flex-direction: column;
    gap: var(--sp-l);
    margin-block-start: var(--sp-m);
  }

  /*
   * Вопрос и ответ разведены по колонкам: вопрос остаётся заголовком слева,
   * ответ держит свою меру справа. Одной колонкой это читалось сплошным
   * текстом — ровно то, из-за чего страница выглядела статьёй.
   */
  .qa {
    display: grid;
    gap: var(--sp-2xs);
    padding-block-start: var(--sp-s);
    border-block-start: 1px solid var(--c-rule);
  }

  @media (width >= 60rem) {
    .qa {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--sp-l);
    }
  }

  .qa__side {
    min-inline-size: 0;
  }

  .qa__no {
    display: block;
    margin-block-end: var(--sp-3xs);
  }

  .qa__q {
    font-size: var(--fs-300);
    margin: 0;
    text-wrap: balance;
  }

  .qa__a {
    margin: 0;
    color: var(--c-muted);
    min-inline-size: 0;
  }

  /* ── Разборы ────────────────────────────────────────────────── */
  .posts {
    list-style: none;
    padding: 0;
    margin-block: var(--sp-m) 0;
    max-inline-size: none;
    display: grid;
    gap: var(--sp-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .posts li + li {
    margin-block-start: 0;
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3xs);
    min-inline-size: 0;
    border-block-start: 3px solid var(--c-brass);
  }

  .post__no {
    color: var(--c-muted);
  }

  .post__title {
    font-size: var(--fs-300);
    margin: 0;
  }

  .post__title a {
    text-decoration: none;
  }

  /*
   * Ссылка растянута на всю карточку: цель нажатия — карточка, а не строчка
   * заголовка. Текст остаётся ссылкой для скринридера, накладка — пустая.
   */
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .post {
    position: relative;
  }

  .post:hover .post__title a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .post__lede {
    margin: 0;
    font-size: var(--fs-100);
    color: var(--c-muted);
  }

  /* ── Финал ──────────────────────────────────────────────────── */
  .final {
    max-inline-size: none;
  }

  .final__title {
    margin-block-end: var(--sp-2xs);
  }

  .final__text {
    margin-block-end: var(--sp-m);
    color: var(--c-muted);
  }
</style>
