---
import { business } from '../data/business.ts';

interface Props {
  /** slug текущей страницы — её саму в список не включаем. */
  current: string;
}

const { current } = Astro.props;

const others = business.services.filter((s) => s.status === 'live' && s.slug !== current);
---

<nav class="related" aria-label="Другие услуги">
  <p class="inst inst--muted related__label">Ещё делаю</p>
  <ul>
    {
      others.map((s) => (
        <li>
          <a href={`/${s.slug}/`}>{s.name}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .related__label {
    margin-block: 0 var(--sp-2xs);
  }

  .related ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2xs) var(--sp-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related li + li {
    margin-block-start: 0;
  }

  .related a {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.75rem;
    font-weight: 700;
  }
</style>
