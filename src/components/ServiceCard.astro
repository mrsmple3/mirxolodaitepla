---
import ServiceIcon from './ServiceIcon.astro';
import type { Service } from '../data/business.ts';

interface Props {
  service: Service;
  /** Короткое описание карточки. Живёт на странице, а не в данных. */
  summary: string;
}

const { service, summary } = Astro.props;

/*
 * Ссылка появляется только когда страница услуги действительно собрана
 * (status: 'live' в business.ts). До этого карточка остаётся текстом —
 * ссылок в никуда на сайте не бывает, это ловит npm run links.
 */
const href = service.status === 'live' ? `/${service.slug}/` : null;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['card', 'lift', 'service', { 'service--linked': href }]} href={href}>
  <div class="service__head">
    <ServiceIcon domain={service.domain} />
    <h3 class="service__name">{service.name}</h3>
  </div>
  <p class="service__summary">{summary}</p>
  {
    href && (
      <span class="service__go" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12h15" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </span>
    )
  }
</Tag>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3xs);
    min-inline-size: 0;
    color: inherit;
    text-decoration: none;
    border-block-start: 3px solid var(--c-brass);
  }

  .service__head {
    display: flex;
    align-items: center;
    gap: var(--sp-2xs);
    color: var(--c-muted);
  }

  .service__name {
    font-size: var(--fs-300);
    margin: 0;
    color: var(--c-graphite);
  }

  .service--linked .service__name {
    color: var(--c-accent);
  }

  .service--linked .service__head {
    color: var(--c-accent);
  }

  .service--linked:hover {
    border-color: var(--c-accent);
  }

  .service--linked:hover .service__name {
    color: var(--c-accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .service__summary {
    margin: 0;
    font-size: var(--fs-100);
    color: var(--c-muted);
  }

  /*
   * Стрелка выезжает при наведении. Она не несёт смысла — что карточка
   * ведёт на страницу, уже сказано заголовком-ссылкой, — поэтому
   * aria-hidden и никакого текста внутри.
   */
  .service__go {
    display: flex;
    align-items: center;
    align-self: flex-end;
    margin-block-start: auto;
    padding-block-start: var(--sp-2xs);
    color: var(--c-accent);
    translate: 0 0;
    opacity: 0.55;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
  }

  .service--linked:hover .service__go {
    opacity: 1;
    translate: 0.35rem 0;
  }
</style>
